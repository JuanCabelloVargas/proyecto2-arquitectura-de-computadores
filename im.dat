// Programa simple: Contador de 15 a 0
// Para la FPGA Go Board - optimizado para ICE40HX1K

// Inst 0: MOV A, 15     | Cargar 15 en el registro A (inicializar contador)
000001000001111

// Inst 1: MOV B, A      | Copiar A a B para mostrar en LEDs
000010100000000

// Inst 2: SUB A, 1      | Decrementar A (A = A - 1)
000101000000001

// Inst 3: CMP A, 255    | Comparar A con 255 (para detectar underflow: 0-1=255)
100111011111111

// Inst 4: JNE 1         | Si A != 255, saltar a instrucción 1 (continuar loop)
101110000000001

// Inst 5: MOV A, 15     | Si llegamos aquí (A=255), reiniciar contador a 15
000001000001111

// Inst 6: JMP 1         | Saltar a instrucción 1 (reiniciar loop)
101000000000001

